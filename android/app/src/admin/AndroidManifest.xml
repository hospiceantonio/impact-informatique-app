<?xml version="1.0" encoding="utf-8"?>
<!-- Ce que seule BIZZOO Admin déclare : la position du livreur pendant
     ses courses, application fermée (« Localiser un livreur » dans
     BIZZOO Personnel). Android exige un service au premier plan, de
     type « location », et ses deux permissions. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- (3.70.0) Le livreur « disponible » : sa position, application
         fermée. Le processeur reste éveillé le temps d'un envoi ; la
         position « Toujours » et l'exemption d'économie de batterie
         permettent à Android de relancer le suivi s'il l'a arrêté. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application>
        <service
            android:name="com.impactinformatique.apps.ServiceSuiviPosition"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
