<?xml version="1.0" encoding="utf-8"?>
<!-- L'écran affiché le temps que l'application s'ouvre : le fond
     blanc, et l'icône au centre. On réutilise l'icône elle-même,
     pour n'avoir qu'un seul dessin à tenir à jour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/fond_demarrage" />
    <item>
        <bitmap android:src="@mipmap/ic_launcher" android:gravity="center" />
    </item>
</layer-list>
